{
  "defaultThinkingLevel": "low",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.4.0",
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "theme": "system",
  "tuiMode": "regular",
  "extensions": [
    "-builtin:codemode",
    "-builtin:llama.cpp"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "radius/recursive/flint",
    "antigravity/gemini-3.8-flash"
  ],
  "skills": [
    "~/workspace/lean/skills",
    "~/workspace/security-audit-skill/skills"
  ],
  "packages": [
    {
      "source": "npm:pi-subagents",
      "skills": [
        "-skills/council-mode/SKILL.md",
        "-skills/pi-subagents/SKILL.md"
      ],
      "prompts": [
        "-prompts/council.md",
        "-prompts/gather-context-and-clarify.md",
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-research.md",
        "-prompts/parallel-review.md",
        "-prompts/review-loop.md"
      ]
    },
    {
      "source": "npm:pi-antigravity"
    }
  ],
  "subagents": {
    "disableThinking": true,
    "agentOverrides": {
      "evidence-auditor": {
        "tools": "inherit"
      },
      "researcher": {
        "tools": "inherit"
      },
      "reviewer": {
        "tools": "inherit"
      },
      "scout": {
        "tools": "inherit"
      },
      "worker": {
        "tools": "inherit"
      },
      "oracle": {
        "tools": "inherit"
      },
      "delegate": {
        "tools": "inherit"
      },
      "claude-code": {
        "tools": "inherit"
      },
      "claude-code-writer": {
        "tools": "inherit"
      },
      "codex-exec": {
        "tools": "inherit"
      },
      "codex-exec-writer": {
        "tools": "inherit"
      },
      "cursor-agent": {
        "tools": "inherit"
      },
      "cursor-agent-writer": {
        "tools": "inherit"
      }
    }
  }
}